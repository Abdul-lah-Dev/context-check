# Context Check settings. Copy this file to .env and fill in your own key.
# NEVER put your real key in this file: .env.example goes on GitHub.

# Google Gemini (free tier, what we use in class). Key: https://aistudio.google.com/apikey
LLM_API_KEY=paste-your-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-4-hydrogen

# Using another provider? Replace the two lines above with one pair below
# (and use that provider's key for LLM_API_KEY).
#
# OpenAI       LLM_BASE_URL=https://api.openai.com/v1
#              LLM_MODEL=gpt-5-nano
# Claude       LLM_BASE_URL=https://api.anthropic.com/v1/
#              LLM_MODEL=claude-haiku-5-5
# Groq         LLM_BASE_URL=https://api.groq.com/openai/v1
#              LLM_MODEL=openai/gpt-oss-20b
# OpenRouter   LLM_BASE_URL=https://openrouter.ai/api/v1
#              LLM_MODEL=a model name ending in :free (see openrouter.ai/models)
# Ollama       LLM_BASE_URL=http://localhost:11434/v1
#              LLM_MODEL=gpt-oss:20b      (and LLM_API_KEY=ollama)
